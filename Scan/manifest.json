{
  "manifest_version": 3,
  "name": "Scan",
  "version": "1.0.2",
  "description": "QUÉT bệnh nhân trên HIS: xét nghiệm, thuốc, PTTT, BHYT, thiếu chẩn đoán, xét nghiệm lặp lại.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://bvdksoctrang.vncare.vn/*",
    "https://gdbhyt.baohiemxahoi.gov.vn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://bvdksoctrang.vncare.vn/vnpthis/main/manager.jsp*"
      ],
      "js": [
        "main.js",
        "icd_capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://bvdksoctrang.vncare.vn/vnpthis/main/manager.jsp*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gdbhyt.baohiemxahoi.gov.vn/ThongTuyenLSKCB/Index*"
      ],
      "js": [
        "portal_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gdbhyt.baohiemxahoi.gov.vn/ThongTuyenLSKCB/Index*"
      ],
      "js": [
        "bhyt_portal.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service_worker.js"
  }
}
